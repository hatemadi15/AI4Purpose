# Server
PORT=5000

# Database
SQLITE_STORAGE=data/medalert.sqlite
# Alternative:
# DATABASE_URL=sqlite:data/medalert.sqlite

# AI and external APIs
GEMINI_API_KEY=
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=
OPENWEATHER_API_KEY=
TOMORROW_IO_API_KEY=
NEWSAPI_AI_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@medalert.demo

# Detection tuning
DETECTION_WINDOW_HOURS=6
NEWS_SAME_EVENT_WINDOW_HOURS=6

# Optional comma-separated default source lists.
# Leave blank to enable all available sources for the stage.
ENABLED_DETECTION_SOURCES=
ENABLED_VERIFICATION_SOURCES=
